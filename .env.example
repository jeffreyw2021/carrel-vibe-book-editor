# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ── Database ──────────────────────────────────────────────────────────────────
# Pooled connection (runtime queries)
DATABASE_URL=
# Direct connection (Prisma migrations / db push)
DATABASE_URL_UNPOOLED=

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=

# ── Environment ───────────────────────────────────────────────────────────────
NODE_ENV=development
# TanStack React Query Devtools (dev only): CSS opacity 0–1 when idle; hover shows full opacity.
NEXT_PUBLIC_REACT_QUERY_DEVTOOLS_IDLE_OPACITY=0.01

# ── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
